@{
    ViewBag.Title = "Climate & Sustainability Scores";
}

<main class="login-page" aria-labelledby="title">
    <div class="container">
        <div class="row justify-content-center align-items-center">
            <div class="col-md-9 col-lg-7">
                <div class="card login-card">
                    <div class="login-card-top-bar"></div>
                    <div class="card-body p-4 p-md-5">
                        <div class="text-center">
                            <div class="login-brand-badge" aria-hidden="true">
                                <svg xmlns="http://www.w3.org/2000/svg" width="34" height="34" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                     stroke-linejoin="round">
                                    <circle cx="12" cy="8" r="6"/>
                                    <path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/>
                                </svg>
                            </div>
                            <span class="badge-coming-soon mb-2"
                                  style="position: static;">Module Under Development</span>
                            <h2 class="login-title" id="title">View Scores</h2>
                            <p class="login-subtitle">Your personal sustainability scorecards and climate impact
                                metrics</p>
                        </div>

                        <div class="p-4 my-4 rounded-3 text-center"
                             style="background: linear-gradient(135deg, #f0fdf4 0%, #e8f5ed 100%); border: 1.5px dashed #86efac;">
                            <div class="d-inline-flex p-3 rounded-circle mb-3"
                                 style="background: #ffffff; color: #2d6a4f; box-shadow: 0 4px 12px rgba(45, 106, 79, 0.1);">
                                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                     stroke-linejoin="round">
                                    <path d="M12 2v4"/>
                                    <path d="m4.93 4.93 2.83 2.83"/>
                                    <path d="M2 12h4"/>
                                    <path d="m4.93 19.07 2.83-2.83"/>
                                    <path d="M12 18v4"/>
                                    <path d="m19.07 19.07-2.83-2.83"/>
                                    <path d="M18 12h4"/>
                                    <path d="m19.07 4.93-2.83 2.83"/>
                                </svg>
                            </div>
                            <h4 class="fw-bold mb-2" style="color: #1b4332;">Scoring Engine Coming Soon</h4>
                            <p class="text-muted small mb-0"
                               style="max-width: 420px; margin: 0 auto; line-height: 1.5;">
                                We are finalizing the climate scoring algorithms, quiz metrics, and carbon-reduction
                                milestones. Check back soon for comprehensive analytics on your sustainability journey.
                            </p>
                        </div>

                        <div class="d-grid mb-3">
                            @Html.ActionLink("Return to Account Dashboard", "Index", "Manage", null, new { @class = "btn btn-dashboard-action py-2" })
                        </div>

                        <div class="login-eco-footer mt-4">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                 stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"/>
                                <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/>
                                <path d="M2 12h20"/>
                            </svg>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>
